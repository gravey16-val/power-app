# =============================================================================
# Weather Dashboard — environment variable template
#
# Copy this file to `.env` and adjust as needed for local development:
#
#     cp .env.example .env
#
# `.env` is gitignored and is read automatically by `docker compose`.
# Never commit real secrets — this file documents variables only.
# =============================================================================

# --- PostgreSQL (db service) -------------------------------------------------
# Credentials used to initialise the local Postgres container. For local dev the
# defaults below are fine; in any shared/production environment use strong,
# secret values supplied by your platform (e.g. Render).
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weatherdb

# --- Backend (backend service) -----------------------------------------------
# Full SQLAlchemy/PostgreSQL connection string. The host `db` is the Compose
# service name. Must match the POSTGRES_* values above.
# Required — the backend fails fast on startup if this is unset.
DATABASE_URL=postgresql://weather:weather@db:5432/weatherdb

# Comma-separated list of origins allowed by CORS. Defaults to the local
# frontend if unset. Do NOT use "*" together with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend service) ---------------------------------------------
# Base URL the browser uses to reach the backend API. Baked in at build time.
VITE_API_URL=http://localhost:8000
