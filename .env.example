# Template for local environment variables. Copy to `.env` and adjust.
# `.env` is gitignored — never commit real credentials.
#
# For docker-compose these values are already provided in docker-compose.yml;
# this file documents the contract for running services standalone or on Render.

# --- Backend ---
# PostgreSQL connection string. Required — the backend fails fast if unset.
# On Render this is injected from the managed database; do not hardcode it.
DATABASE_URL=postgresql://weather:weather@db:5432/weatherdb

# Comma-separated list of allowed CORS origins. "*" is dev-only.
# In production set this to the deployed frontend origin,
# e.g. https://weather-frontend.onrender.com
CORS_ORIGINS=*

# --- Frontend ---
# Base URL of the backend API, baked into the Vite build at build/serve time.
VITE_API_URL=http://localhost:8000
